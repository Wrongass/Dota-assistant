# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Общий пароль команды для входа на сайт (длинный, не из словаря)
SITE_PASSWORD=

# Домен сайта для HTTPS (A-запись должна указывать на IP сервера), например dota.example.ru
DOMAIN=

# Необязательно: ключ OpenDota (больше лимит запросов)
OPENDOTA_API_KEY=

# Необязательно: порт сайта на 127.0.0.1 (по умолчанию 8070)
# WEB_PORT=8070

# Необязательно: токен STRATZ (stratz.com/api → «Мои токены», бесплатный после входа через Steam).
# Нужен для статистики линии «герой против героя»; без него вкладка «Контрпики» показывает только «по игре».
STRATZ_TOKEN=
